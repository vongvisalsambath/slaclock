{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && bash /tmp/dotnet-install.sh --channel 10.0 --install-dir /tmp/dotnet",
  "buildCommand": "/tmp/dotnet/dotnet publish site/SlaClock.Demo -c Release -o out",
  "outputDirectory": "out/wwwroot",
  "framework": null,
  "headers": [
    {
      "source": "/_framework/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
